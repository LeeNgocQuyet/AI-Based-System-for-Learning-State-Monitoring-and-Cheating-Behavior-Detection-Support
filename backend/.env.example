APP_NAME=Group 3 Learning Monitoring API
ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/learning_monitor
JWT_SECRET=group3-secure-dev-jwt-secret-key-32chars-min-local-demo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
SERVICE_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Local demo seed credentials
DEMO_LEARNER1_EMAIL=learner.one@example.edu
DEMO_LEARNER2_EMAIL=learner.two@example.edu
DEMO_INSTRUCTOR_EMAIL=instructor.demo@example.edu
DEMO_LEARNER1_PASSWORD=DemoLearnerPassword123!
DEMO_LEARNER2_PASSWORD=DemoLearnerPassword123!
DEMO_INSTRUCTOR_PASSWORD=DemoInstructorPassword123!

# Experimental signal; keep false unless the AI team confirms model stability.
ENABLE_PHONE_DETECTION=false
