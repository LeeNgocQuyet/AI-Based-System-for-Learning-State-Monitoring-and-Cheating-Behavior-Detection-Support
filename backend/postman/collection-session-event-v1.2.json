{
  "info": {
    "_postman_id": "b7f0cf4d-9a01-4a14-a8a6-8d62c849d120",
    "name": "Group 3 - Session Event API v1.2",
    "description": "Request collection for session lifecycle, event ingestion, listing, reporting and RBAC smoke tests. Import the environment template and fill in valid tokens generated by the local scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "eventId",
      "value": "",
      "type": "string"
    },
    {
      "key": "occurredAt",
      "value": "",
      "type": "string"
    },
    {
      "key": "examSessionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API is healthy', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Create and start LEARNING session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/sessions",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{learnerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_type\": \"LEARNING\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Session created and started', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.environment.set('sessionId', body.data.session_id);",
              "pm.test('Backend assigns session_id and ACTIVE status', () => {",
              "  pm.expect(body.data.session_id).to.be.a('string');",
              "  pm.expect(body.data.status).to.eql('ACTIVE');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - List my sessions",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/sessions/mine",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{learnerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Own sessions are returned', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Pause session",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/status",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{learnerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"PAUSED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Session paused', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.status).to.eql('PAUSED'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Start/resume session",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/start",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{learnerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Session resumed', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.status).to.eql('ACTIVE'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Post BROWSER event (learner token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/events",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{learnerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"{{eventId}}\",\n  \"schema_version\": \"1.0.0\",\n  \"session_id\": \"{{sessionId}}\",\n  \"event_type\": \"TAB_HIDDEN\",\n  \"occurred_at\": \"{{occurredAt}}\",\n  \"source\": \"BROWSER\",\n  \"metadata\": {\n    \"visibility_state\": \"hidden\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('eventId', pm.variables.replaceIn('{{$guid}}'));",
              "pm.environment.set('occurredAt', new Date().toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Browser event accepted', () => pm.response.to.have.status(201));",
              "const event = pm.response.json().data;",
              "pm.test('Backend assigns severity and received_at', () => {",
              "  pm.expect(event.severity).to.eql('MEDIUM');",
              "  pm.expect(event.received_at).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Post AI_LEARNING event (service token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/events",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{aiLearningToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"{{aiEventId}}\",\n  \"schema_version\": \"1.0.0\",\n  \"session_id\": \"{{sessionId}}\",\n  \"event_type\": \"EYES_CLOSED_LONG\",\n  \"occurred_at\": \"{{occurredAt}}\",\n  \"source\": \"AI_LEARNING\",\n  \"duration_ms\": 4200,\n  \"confidence\": 0.94,\n  \"metadata\": {\n    \"eye_closure_ms\": 4200\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('aiEventId', pm.variables.replaceIn('{{$guid}}'));",
              "pm.environment.set('occurredAt', new Date().toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AI event accepted', () => pm.response.to.have.status(201));",
              "pm.test('Severity is derived by Backend', () => pm.expect(pm.response.json().data.severity).to.eql('MEDIUM'));"
            ]
          }
        }
      ]
    },
    {
      "name": "06b - Post AI_EXAM event to seeded EXAM session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{aiExamToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"{{examEventId}}\",\n  \"schema_version\": \"1.0.0\",\n  \"session_id\": \"{{examSessionId}}\",\n  \"event_type\": \"MULTIPLE_FACES_DETECTED\",\n  \"occurred_at\": \"{{occurredAt}}\",\n  \"source\": \"AI_EXAM\",\n  \"confidence\": 0.91,\n  \"metadata\": {\n    \"face_count\": 2\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/sessions/{{examSessionId}}/events",
        "description": "Use the active EXAM session ID printed by seed_demo.py. This request proves AI_EXAM tokens are scoped to EXAM events."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('examEventId', pm.variables.replaceIn('{{$guid}}'));",
              "pm.environment.set('occurredAt', new Date().toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AI_EXAM event accepted', () => pm.response.to.have.status(201));",
              "pm.test('Correct source returned', () => pm.expect(pm.response.json().data.source).to.eql('AI_EXAM'));"
            ]
          }
        }
      ]
    },
