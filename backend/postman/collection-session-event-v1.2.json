    {
      "name": "12 - Negative: learner cannot emit AI source",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/events",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{learnerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"{{spoofEventId}}\",\n  \"schema_version\": \"1.0.0\",\n  \"session_id\": \"{{sessionId}}\",\n  \"event_type\": \"EYES_CLOSED_LONG\",\n  \"occurred_at\": \"{{occurredAt}}\",\n  \"source\": \"AI_LEARNING\",\n  \"duration_ms\": 4200,\n  \"confidence\": 0.94,\n  \"metadata\": {}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('spoofEventId', pm.variables.replaceIn('{{$guid}}'));",
              "pm.environment.set('occurredAt', new Date().toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Learner spoofing AI is blocked', () => pm.response.to.have.status(403));"
            ]
          }
