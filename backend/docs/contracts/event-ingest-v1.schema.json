{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:group3:learning-monitor:event-ingest:1.0.0",
  "title": "Event Ingest Payload v1",
  "description": "Payload sent by the browser or AI modules to Backend. Backend assigns severity, received_at and the display message.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID generated by the event producer; used for deduplication."
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Semantic version of this event payload schema."
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "description": "Session UUID returned by Backend when the session is created."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "EYES_CLOSED_LONG",
        "YAWN_DETECTED",
        "HEAD_NOD_DETECTED",
        "LOOK_AWAY_DETECTED",
        "FACE_NOT_DETECTED",
        "MULTIPLE_FACES_DETECTED",
        "PHONE_DETECTED",
        "TAB_HIDDEN",
        "CAMERA_LOST",
        "CONNECTION_LOST"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "Time the event occurred, formatted as RFC 3339 UTC with Z suffix."
    },
    "source": {
      "type": "string",
      "enum": [
        "AI_LEARNING",
        "AI_EXAM",
        "BROWSER",
        "SYSTEM"
      ],
      "description": "Standard producer identifier, not a model name or a free-form string."
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Observed duration of this event, in milliseconds. Omit for instantaneous events or when duration is not known."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Optional AI confidence score in the range 0..1. Omit for browser/system events. It is not event severity."
    },
    "metadata": {
      "type": "object",
      "description": "Optional event-specific structured details. Do not put raw video frames, base64 images, or secrets here.",
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "schema_version",
    "session_id",
    "event_type",
    "occurred_at",
    "source"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "TAB_HIDDEN"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "BROWSER"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "EYES_CLOSED_LONG",
              "YAWN_DETECTED",
              "HEAD_NOD_DETECTED"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "AI_LEARNING"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "MULTIPLE_FACES_DETECTED",
              "PHONE_DETECTED"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "AI_EXAM"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "LOOK_AWAY_DETECTED",
              "FACE_NOT_DETECTED"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "enum": [
              "AI_LEARNING",
              "AI_EXAM"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "CAMERA_LOST"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "BROWSER"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "CONNECTION_LOST"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "SYSTEM"
          }
        }
      }
    }
  ]
}
