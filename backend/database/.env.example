# PostgreSQL 15+ connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learning_monitor

# Pre-provisioned instructor details (seed only)
INSTRUCTOR_EMAIL=instructor.demo@university.edu.vn
INSTRUCTOR_FULL_NAME=Demo Instructor
INSTRUCTOR_PASSWORD=ReplaceWithStrongPrivatePassword123!

# JWT Auth & Security Settings
JWT_SECRET_KEY=replace-with-a-random-64-character-secret-key-for-local-development
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
